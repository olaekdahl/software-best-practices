%%{init: {'theme': 'neutral'}}%%
erDiagram
    CUSTOMER ||--o{ ORDER : places
    ORDER ||--|{ ORDER_ITEM : contains
    PRODUCT ||--o{ ORDER_ITEM : "ordered in"
    ORDER ||--o| PAYMENT : "paid by"
    ORDER ||--o| SHIPMENT : "shipped via"
    CUSTOMER ||--o{ ADDRESS : has

    CUSTOMER {
        uuid id PK
        string name
        string email UK
        string phone
        datetime created_at
    }

    ADDRESS {
        uuid id PK
        uuid customer_id FK
        string street
        string city
        string state
        string zip
        string country
        boolean is_default
    }

    ORDER {
        uuid id PK
        uuid customer_id FK
        uuid shipping_address_id FK
        string status "DRAFT|SUBMITTED|CONFIRMED|SHIPPED|DELIVERED|CANCELLED"
        decimal total
        string currency "USD"
        datetime created_at
        datetime updated_at
    }

    ORDER_ITEM {
        uuid id PK
        uuid order_id FK
        uuid product_id FK
        int quantity
        decimal unit_price
        decimal line_total
    }

    PRODUCT {
        uuid id PK
        string name
        string sku UK
        decimal price
        int stock_quantity
        string category
        boolean is_active
    }

    PAYMENT {
        uuid id PK
        uuid order_id FK
        decimal amount
        string method "CARD|BANK|WALLET"
        string status "PENDING|CAPTURED|REFUNDED|FAILED"
        string transaction_id
        datetime processed_at
    }

    SHIPMENT {
        uuid id PK
        uuid order_id FK
        string carrier "UPS|FEDEX|USPS|DHL"
        string tracking_number
        string status "LABEL_CREATED|IN_TRANSIT|DELIVERED|RETURNED"
        datetime shipped_at
        datetime delivered_at
    }
